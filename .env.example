# Public URL of this Netlify site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-honor-roll-registration-site.netlify.app

# Keep false until the complete sandbox test has passed and production
# QuickBooks credentials, item IDs, webhooks, and Big Form settings are ready.
REGISTRATION_ENABLED=false

# Intuit Developer application (QuickBooks Online Accounting scope).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://your-honor-roll-registration-site.netlify.app/api/quickbooks/callback
QBO_ENVIRONMENT=production
QBO_SETUP_KEY=replace-with-a-long-random-admin-key
QBO_WEBHOOK_VERIFIER_TOKEN=

# Existing QuickBooks Products/Services item IDs used on invoice lines.
QBO_REGISTRATION_ITEM_ID=
QBO_OPTIONAL_ITEM_ID=

# Paid contestants receive this form URL. The registration ID and one-time
# workflow token are appended as query parameters.
BIG_FORM_URL=https://your-big-form.netlify.app
BIG_FORM_CALLBACK_SECRET=replace-with-a-different-long-random-key

# Configure both values to place a prominent Big Form button and link directly
# in the paid-registration email body. If omitted, the app falls back to adding
# the link to the paid QuickBooks invoice and emailing the invoice again.
RESEND_API_KEY=
EMAIL_FROM=Texas Our Little Miss <registration@updates.texasourlittlemiss.net>
